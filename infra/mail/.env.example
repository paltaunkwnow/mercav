# Copy to .env on the dedicated mail host; never commit credentials.
# Before production replace BOTH images with tested immutable @sha256 digests.
STALWART_IMAGE=stalwartlabs/stalwart:v0.16
CADDY_IMAGE=caddy:2
MAIL_HOST=mail.mercav.lat
MX_HOST=mx1.mercav.lat
MTA_STS_HOST=mta-sts.mercav.lat
ACME_EMAIL=seguridad@mercav.lat
MAIL_STATE_DIR=/srv/mercav-mail
# Existing Mercav Next.js server, reached through the Linux host gateway.
# Bind the app to an interface reachable from Docker, firewall it to Docker only,
# or replace this with a private VPN address of the separate webmail host.
MERCAV_MAIL_UPSTREAM=host.docker.internal:3000
# Used by backup.sh only; provision the password outside this checkout.
RESTIC_REPOSITORY=s3:https://REPLACE_S3_ENDPOINT/REPLACE_BUCKET/mercav-mail
RESTIC_PASSWORD_FILE=/etc/mercav-mail/restic-password.secret
