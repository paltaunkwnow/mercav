generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  password            String?
  name                String
  username            String          @unique
  avatar              String?
  coverImage          String?
  bio                 String?         @db.VarChar(600)
  location            String?
  country             String?
  countryCode         String?
  timezone            String?
  isVerified          Boolean         @default(false)
  twoFactorSecret     String?
  twoFactorEnabled    Boolean         @default(false)
  profileCompleteness Int             @default(0)
  plan                Plan            @default(FREE)
  planExpiresAt       DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  applications        Application[]
  following           Follow[]        @relation("UserFollowing")
  followers           Follow[]        @relation("UserFollowers")
  sentMessages        Message[]       @relation("SenderMessages")
  jobPosts            JobPost[]       @relation("UserJobPosts")
  notifications       Notification[]
  posts               Post[]
  postComments        PostComment[]
  postLikes           PostLike[]
  profile             Profile?
  reportsMade         Report[]
  reservations        Reservation[]
  savedJobs           SavedJob[]
  services            Service[]
  clientOrders        ServiceOrder[]  @relation("ClientOrders")
  reviewsGivenService ServiceReview[]
  spaces              Space[]
  reviewsGivenSpace   SpaceReview[]
  subscriptions       Subscription[]
  suspensions         Suspension[]
  uploadedFiles       ProjectFile[]
  toolUsages          ToolUsage[]
  roles               UserRole[]
  savedSpaces         SavedSpace[]
  savedServices       SavedService[]
  conversations       Conversation[]  @relation("UserConversations")
  companyMemberships  CompanyMember[]
  transactions        Transaction[]
  tickets             Ticket[]        @relation("UserTickets")
  involvedTickets     Ticket[]        @relation("InvolvedUserTickets")
  ticketReplies       TicketReply[]
  posConfig           POSConfig?
  /// MercavClub: código de la cuenta para que cualquier negocio la encuentre (MC-XXXX-XXXX).
  clubCode            String?         @unique
  loyaltyCards        LoyaltyCard[]
  toolRuns            ToolRun[]
  badges              Badge[]         @relation("UserBadges")

  // Mercav Business y calendario (app.mercav.lat)
  businessWorkspacesOwned BusinessWorkspace[] @relation("BusinessOwner")
  businessMemberships     BusinessMember[]
  businessEmployeeRecords BusinessEmployee[]
  calendarPreference      CalendarPreference?
  /// Última empresa abierta y preferencias de la guía de inicio. No conceden acceso por sí solas.
  lastBusinessWorkspaceId String?
  businessGuideProgress  BusinessGuideProgress[]

  // Sanction System
  isSanctioned      Boolean                 @default(false)
  sanctionReason    String?
  sanctionExpiresAt DateTime?
  nit               String?
  ci                String?
  adminLogs         AdminLog[]              @relation("AdminLogs")
  deletedContents   DeletedContentHistory[] @relation("DeletedContents")

  // Mercav Pwn
  pwnTargets PwnMonitoringTarget[]
  pwnAlerts  PwnAlert[]
  pwnReports PwnReport[]

  // Mercav Kosher
  kosherProfile       KosherProfile?
  kosherPlaces        KosherPlace[]             @relation("KosherPlaceCreator")
  kosherStock         KosherStockReport[]
  kosherStockConfirms KosherStockConfirmation[]
  kosherEdits         KosherEditSuggestion[]    @relation("KosherEditAuthor")
  kosherReviews       KosherReview[]
  kosherMessages      KosherMessage[]
  kosherFlags         KosherMessageFlag[]
  kosherEvents        KosherEvent[]
  kosherMinyanim      KosherMinyan[]
  kosherMinyanRsvps   KosherMinyanRsvp[]
  kosherHost          KosherHost?
  kosherHostRequests  KosherHostRequest[]
  kosherChesed        KosherChesed[]
  kosherAlerts        KosherAlert[]
  kosherManaged       KosherPlaceManager[]
  kosherClaims        KosherClaim[]
  kosherPhotos        KosherPhoto[]             @relation("KosherPhotoUploader")
  kosherFavorites     KosherFavorite[]
  unusualTraffic      UnusualTrafficEvent[]
}

model Company {
  id          String          @id @default(uuid())
  name        String          @unique
  logo        String?
  website     String?
  description String?
  isVerified  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     CompanyMember[]
  jobPosts    JobPost[]       @relation("OfficialCompanyJobs")
}

model CompanyMember {
  id        String       @id @default(uuid())
  companyId String
  userId    String
  role      String       @default("MEMBER")
  status    MemberStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      RoleType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Profile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  headline           String?
  publicEmail        String?
  website            String?
  profileType        String?             @default("PERSONAL")
  availabilityStatus AvailabilityStatus?
  availabilityWeeks  Int?
  workMode           WorkMode?
  salaryMin          Int?
  salaryMax          Int?
  salaryVisible      Boolean             @default(false)
  salaryCurrency     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  certifications     Certification[]
  educations         Education[]
  experiences        Experience[]
  languages          Language[]
  portfolioItems     PortfolioItem[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             Skill[]
}

model Experience {
  id          String    @id @default(uuid())
  profileId   String
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  currentJob  Boolean   @default(false)
  description String?
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id                String   @id @default(uuid())
  profileId         String
  institution       String
  degree            String
  field             String?
  startYear         Int
  endYear           Int?
  currentlyStudying Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String     @id @default(uuid())
  profileId String
  name      String
  level     SkillLevel
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Language {
  id        String        @id @default(uuid())
  profileId String
  name      String
  level     LanguageLevel
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Certification {
  id        String   @id @default(uuid())
  profileId String
  name      String
  issuer    String
  year      Int
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PortfolioItem {
  id          String            @id @default(uuid())
  profileId   String
  title       String
  description String?
  imageUrl    String?
  projectUrl  String?
  category    PortfolioCategory
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Space {
  id                String        @id @default(uuid())
  ownerId           String
  title             String
  description       String
  type              SpaceType
  address           String
  city              String
  country           String
  latitude          Float?
  longitude         Float?
  width             Float
  height            Float
  unit              Unit
  hasLighting       Boolean
  trafficEstimate   Int?
  pricePerDay       Decimal?
  pricePerWeek      Decimal?
  pricePerMonth     Decimal?
  currency          String
  orientation       String?       @default("Horizontal")
  material          String?       @default("Lona")
  minContractMonths Int?          @default(1)
  isActive          Boolean       @default(true)
  isFirstRentalFree Boolean       @default(true)
  isUnderReview     Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  posts             Post[]
  reservations      Reservation[]
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images            SpaceImage[]
  reviews           SpaceReview[]
  savedBy           SavedSpace[]
}

model SpaceImage {
  id        String   @id @default(uuid())
  spaceId   String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model Reservation {
  id                String            @id @default(uuid())
  spaceId           String
  advertiserId      String
  startDate         DateTime
  endDate           DateTime
  basePrice         Decimal
  advertiserFee     Decimal
  ownerFee          Decimal
  totalPrice        Decimal
  status            ReservationStatus @default(PENDING)
  isFirstRentalFree Boolean           @default(false)
  paymentId         String?
  briefing          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  advertiser        User              @relation(fields: [advertiserId], references: [id])
  space             Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model SpaceReview {
  id        String   @id @default(uuid())
  spaceId   String
  authorId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model Service {
  id            String           @id @default(uuid())
  providerId    String
  title         String
  description   String
  category      ServiceCategory
  subcategory   String?
  deliveryDays  Int?
  revisions     Int?
  isActive      Boolean          @default(true)
  isUnderReview Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  images        ServiceImage[]
  posts         Post[]
  provider      User             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  orders        ServiceOrder[]
  packages      ServicePackage[]
  reviews       ServiceReview[]
  savedBy       SavedService[]
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServicePackage {
  id           String         @id @default(uuid())
  serviceId    String
  type         PackageType
  name         String
  description  String
  price        Decimal
  deliveryDays Int
  revisions    Int
  features     String[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orders       ServiceOrder[]
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceOrder {
  id             String          @id @default(uuid())
  serviceId      String
  packageId      String
  clientId       String
  providerId     String
  status         OrderStatus     @default(PENDING)
  totalPrice     Decimal
  platformFee    Decimal
  providerPayout Decimal
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  briefing       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  milestones     Milestone[]
  client         User            @relation("ClientOrders", fields: [clientId], references: [id])
  package        ServicePackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reviews        ServiceReview[]
  tickets        Ticket[]
  files          ProjectFile[]
  transactions   Transaction[]
}

model ProjectFile {
  id           String       @id @default(uuid())
  orderId      String
  name         String
  url          String
  size         String
  type         String
  uploadedById String
  createdAt    DateTime     @default(now())
  order        ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
}

model Milestone {
  id          String          @id @default(uuid())
  orderId     String
  title       String
  description String?
  amount      Decimal
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  order       ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ServiceReview {
  id        String       @id @default(uuid())
  serviceId String
  orderId   String
  authorId  String
  rating    Int
  comment   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  author    User         @relation(fields: [authorId], references: [id])
  order     ServiceOrder @relation(fields: [orderId], references: [id])
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model JobPost {
  id                String                @id @default(uuid())
  companyId         String
  officialCompanyId String?
  title             String
  description       String
  requirements      String
  responsibilities  String?
  benefits          String?
  employmentType    EmploymentType
  workMode          WorkMode
  city              String
  country           String
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  salaryVisible     Boolean               @default(false)
  experienceLevel   ExperienceLevel
  expiresAt         DateTime?
  isActive          Boolean               @default(true)
  isUnderReview     Boolean               @default(false)
  viewCount         Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  applications      Application[]
  questions         ApplicationQuestion[]
  company           User                  @relation("UserJobPosts", fields: [companyId], references: [id], onDelete: Cascade)
  officialCompany   Company?              @relation("OfficialCompanyJobs", fields: [officialCompanyId], references: [id])
  posts             Post[]
  savedBy           SavedJob[]
}

model ApplicationQuestion {
  id         String              @id @default(uuid())
  jobPostId  String
  question   String
  type       QuestionType
  options    String[]
  isRequired Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  answers    ApplicationAnswer[]
  jobPost    JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
}

model Application {
  id          String              @id @default(uuid())
  jobPostId   String
  applicantId String
  coverLetter String?
  status      ApplicationStatus   @default(RECIBIDO)
  notes       String?
  chatEnabled Boolean             @default(false)
  appliedAt   DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  applicant   User                @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobPost     JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  answers     ApplicationAnswer[]

  @@unique([jobPostId, applicantId])
}

model ApplicationAnswer {
  id            String              @id @default(uuid())
  applicationId String
  questionId    String
  answer        String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      ApplicationQuestion @relation(fields: [questionId], references: [id])
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobPostId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobPost   JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostId])
}

model SavedSpace {
  id        String   @id @default(uuid())
  userId    String
  spaceId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
}

model SavedService {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
}

model Conversation {
  id           String              @id @default(uuid())
  context      ConversationContext
  contextId    String?
  isEnabled    Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  messages     Message[]
  participants User[]              @relation("UserConversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  attachmentType String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SenderMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Post {
  id              String        @id @default(uuid())
  authorId        String
  content         String
  images          String[]
  videoUrl        String?
  linkUrl         String?
  module          PostModule    @default(GENERAL)
  isActive        Boolean       @default(true)
  isUnderReview   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  jobId           String?
  serviceId       String?
  spaceId         String?
  linkDescription String?
  linkImage       String?
  linkTitle       String?
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  job             JobPost?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  service         Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  space           Space?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  comments        PostComment[]
  likes           PostLike[]
}

model PostLike {
  id        String       @id @default(uuid())
  postId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        String        @id @default(uuid())
  postId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   PostComment[] @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  plan      Plan
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime?
  paymentId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  targetType  TargetType
  targetId    String
  reason      String
  description String
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model ToolUsage {
  id         String   @id @default(uuid())
  userId     String
  toolName   String
  inputData  Json
  outputData Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestorContact {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Suspension {
  id          String    @id @default(uuid())
  userId      String
  reason      String
  suspendedBy String
  startDate   DateTime
  endDate     DateTime?
  isPermanent Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlobalConfig {
  id                    String  @id @default("singleton")
  platformFeePercentage Float   @default(10.0)
  maintenanceMode       Boolean @default(false)
  minVerificationScore  Int     @default(70)
  supportEmail          String  @default("soporte@mercav.lat")

  // Practical Admin Tools
  announcementText      String?
  announcementLink      String?
  allowNewRegistrations Boolean @default(true)
  featuredServiceId     String?
  featuredSpaceId       String?
  maintenanceMessage    String? @default("El sistema está bajo mantenimiento programado. Volveremos pronto.")

  updatedAt DateTime @updatedAt
}

enum Plan {
  FREE
  PROFESSIONAL
  EMPRESA
  ELITE
}

enum RoleType {
  ANUNCIANTE
  DUENO_ESPACIO
  FREELANCER
  CANDIDATO
  ADMIN
}

enum AvailabilityStatus {
  INMEDIATA
  EN_SEMANAS
  NO_DISPONIBLE
}

enum WorkMode {
  PRESENCIAL
  REMOTO
  HIBRIDO
}

enum SkillLevel {
  BASICO
  INTERMEDIO
  AVANZADO
}

enum LanguageLevel {
  BASICO
  INTERMEDIO
  AVANZADO
  NATIVO
}

enum PortfolioCategory {
  ADS
  SERVICES
  GENERAL
}

enum SpaceType {
  LETRERO
  VALLA
  VIDRIERA
  REVISTA
  PACKAGING
  AUTO
  PANTALLA
  OTRO
}

enum Unit {
  CM
  M
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ServiceCategory {
  DESARROLLO_WEB
  DISENO
  MARKETING
  SEO
  REDACCION
  VIDEO
  FOTOGRAFIA
  IA
  CONSULTORIA
  OTRO
}

enum PackageType {
  BASICO
  ESTANDAR
  PREMIUM
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  REVISION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
  PAID
}

enum EmploymentType {
  TIEMPO_COMPLETO
  PART_TIME
  FREELANCE
  PASANTIA
}

enum ExperienceLevel {
  SIN_EXPERIENCIA
  JUNIOR
  SEMI_SENIOR
  SENIOR
}

enum QuestionType {
  TEXTO
  SELECCION_MULTIPLE
  SI_NO
}

enum ApplicationStatus {
  RECIBIDO
  EN_REVISION
  ENTREVISTA
  OFERTA
  CONTRATADO
  DESCARTADO
}

enum ConversationContext {
  GENERAL
  JOB_APPLICATION
  SERVICE_ORDER
  SPACE_INQUIRY
}

enum PostModule {
  ADS
  SERVICES
  JOBS
  GENERAL
}

enum ReactionType {
  INTERESA
  UTIL
  INSPIRADOR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum TargetType {
  USER
  POST
  JOB
  SPACE
  SERVICE
}

model Transaction {
  id        String            @id @default(uuid())
  stripeId  String            @unique
  amount    Decimal
  currency  String
  status    TransactionStatus @default(PENDING)
  metadata  Json?
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tickets   Ticket[]
  orderId   String?
  order     ServiceOrder?     @relation(fields: [orderId], references: [id])
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model Ticket {
  id             String         @id @default(uuid())
  userId         String
  subject        String
  message        String
  category       TicketCategory
  status         TicketStatus   @default(OPEN)
  orderId        String?
  transactionId  String?
  involvedUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  involvedUser   User?          @relation("InvolvedUserTickets", fields: [involvedUserId], references: [id])
  order          ServiceOrder?  @relation(fields: [orderId], references: [id])
  transaction    Transaction?   @relation(fields: [transactionId], references: [id])
  replies        TicketReply[]
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TicketCategory {
  PAYMENT_ERROR
  DOUBLE_PAYMENT
  FRAUD
  SCAM
  TECHNICAL_ISSUE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// La caja. Desde Mercav Business es de una empresa (workspaceId) y la usan sus miembros según su rol; la caja
/// personal de antes (userId) sigue funcionando hasta que el dueño la trae a su empresa.
model POSConfig {
  id               String             @id @default(uuid())
  userId           String?            @unique
  workspaceId      String?            @unique
  shopName         String?
  logoUrl          String?
  currency         String             @default("USD")
  country          String?
  department       String?
  city             String?
  address          String?
  businessType     String             @default("GENERAL")
  taxName          String             @default("IVA")
  taxRate          Decimal            @default(0)
  pricesIncludeTax Boolean            @default(true)
  paymentMethods   String[]           @default(["CASH", "CARD", "TRANSFER", "QR"])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        BusinessWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categories       POSCategory[]
  products         POSProduct[]
  sales            POSSale[]
  cashSessions     POSCashSession[]
  staff            POSStaff[]
  kosherPlaceId    String? // Mercav Kosher place this shop publishes stock to
}

model POSCategory {
  id          String       @id @default(uuid())
  posConfigId String
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  posConfig   POSConfig    @relation(fields: [posConfigId], references: [id], onDelete: Cascade)
  products    POSProduct[]

  @@index([posConfigId])
}

model POSProduct {
  id             String               @id @default(uuid())
  posConfigId    String
  categoryId     String?
  name           String
  description    String?
  price          Decimal
  costPrice      Decimal              @default(0)
  costKnown      Boolean              @default(true)
  stock          Decimal              @default(0)
  sku            String?
  barcode        String?
  unit           String               @default("UNIT") // UNIT, KG, G, L, M
  trackStock     Boolean              @default(true)
  taxRate        Decimal?
  imageUrl       String?
  isActive       Boolean              @default(true)
  isKosher       Boolean              @default(false)
  isHalal        Boolean              @default(false)
  isVegan        Boolean              @default(false)
  isGlutenFree   Boolean              @default(false)
  minStock       Decimal? // low-stock alert threshold
  kosherCategory KosherStockCategory? // set to publish this product's stock to Mercav Kosher
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  posConfig      POSConfig            @relation(fields: [posConfigId], references: [id], onDelete: Cascade)
  category       POSCategory?         @relation(fields: [categoryId], references: [id])
  saleItems      POSSaleItem[]

  @@unique([posConfigId, barcode])
  @@unique([posConfigId, sku])
}

model POSSale {
  id              String         @id @default(uuid())
  posConfigId     String
  cashSessionId   String
  subtotalAmount  Decimal        @default(0)
  taxAmount       Decimal        @default(0)
  totalAmount     Decimal
  discountAmount  Decimal        @default(0)
  discountType    String? // PERCENTAGE or FIXED
  orderType       String         @default("COUNTER") // ids from lib/pos/business.ts
  deliveryChannel String? // Rappi, PedidosYa, etc.
  receivedAmount  Decimal        @default(0)
  changeAmount    Decimal        @default(0)
  transactionId   String         @unique @default(cuid())
  clientNit       String?
  clientName      String?
  status          String         @default("COMPLETED") // COMPLETED, VOIDED
  voidedAt        DateTime?
  voidReason      String?
  voidedById      String? // POSStaff id, null when the owner voided it
  voidedByUserId  String? // cuenta Mercav que anuló (caja de empresa)
  sellerUserId    String? // cuenta Mercav que vendió (caja de empresa)
  clientRef       String?        @unique // idempotency key for sales queued offline
  staffId         String?
  createdAt       DateTime       @default(now())
  staff           POSStaff?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  posConfig       POSConfig      @relation(fields: [posConfigId], references: [id], onDelete: Cascade)
  cashSession     POSCashSession @relation(fields: [cashSessionId], references: [id])
  items           POSSaleItem[]
  payments        POSPayment[]

  @@index([posConfigId, createdAt])
}

model POSSaleItem {
  id          String     @id @default(uuid())
  saleId      String
  productId   String
  productName String?
  unit        String     @default("UNIT")
  quantity    Decimal
  unitPrice   Decimal
  unitCostPrice Decimal?
  subtotal    Decimal
  taxRate     Decimal    @default(0)
  taxAmount   Decimal    @default(0)
  sale        POSSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     POSProduct @relation(fields: [productId], references: [id])
}

model POSPayment {
  id        String   @id @default(uuid())
  saleId    String
  method    String // CASH, CARD, TRANSFER, QR, OTHER
  amount    Decimal
  reference String?
  createdAt DateTime @default(now())
  sale      POSSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model POSCashSession {
  id             String    @id @default(uuid())
  posConfigId    String
  openingAmount  Decimal
  closingAmount  Decimal?
  expectedAmount Decimal?
  difference     Decimal?
  salesByMethod  Json?
  status         String    @default("OPEN") // OPEN, CLOSED
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  staffId        String?
  openedByUserId String? // cuenta Mercav que abrió la caja (caja de empresa)
  closedByUserId String?
  posConfig      POSConfig @relation(fields: [posConfigId], references: [id], onDelete: Cascade)
  staff          POSStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  sales          POSSale[]

  // En SQL también: una sola caja abierta por tienda (índice parcial "POSCashSession_one_open_per_config").
  @@index([posConfigId, status])
}

/// People who use the owner's POS with a PIN. They are not Mercav accounts.
model POSStaff {
  id          String           @id @default(uuid())
  posConfigId String
  name        String
  pinHash     String
  role        String           @default("CASHIER") // CASHIER, MANAGER
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  posConfig   POSConfig        @relation(fields: [posConfigId], references: [id], onDelete: Cascade)
  sales       POSSale[]
  sessions    POSCashSession[]

  @@index([posConfigId])
}

/// Saved results of Mercav Tools (contracts, SEO reports, simulations).
model ToolRun {
  id        String   @id @default(uuid())
  userId    String
  tool      String
  title     String
  input     Json
  output    Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tool, createdAt])
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  icon        String // URL del logo (PNG)
  description String?
  createdAt   DateTime @default(now())
  users       User[]   @relation("UserBadges")
}

model BillingClient {
  id        String   @id @default(uuid())
  nit       String   @unique
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  details   String
  createdAt DateTime @default(now())
  admin     User     @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)
}

model DeletedContentHistory {
  id           String   @id @default(uuid())
  contentType  String // POST, SERVICE, SPACE, JOB
  contentId    String
  contentOwner String
  contentData  Json
  reason       String
  deletedById  String
  deletedAt    DateTime @default(now())
  deletedBy    User     @relation("DeletedContents", fields: [deletedById], references: [id], onDelete: Cascade)
}

// ============================================================
// Mercav Pwn (MVP)
// Never store plaintext passwords, raw emails, leaked tokens or raw dumps.
// Sensitive identifiers are stored only as HMAC-SHA256 hashes (PWN_IDENTIFIER_PEPPER) + redacted hints.
// ============================================================

enum PwnVerificationStatus {
  UNVERIFIED
  PARTIALLY_CORROBORATED
  CORROBORATED
  CONFIRMED
  DISPUTED
}

enum PwnSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PwnTargetType {
  EMAIL
  DOMAIN
  IP
  CVE
}

enum PwnExposureKind {
  EMAIL
  DOMAIN
  PASSWORD_RANGE
  ASSET
}

model PwnSource {
  id                    String             @id @default(uuid())
  name                  String             @unique
  sourceType            String
  historicalReliability Int                @default(50)
  verificationMethod    String?
  lastEvaluatedAt       DateTime?
  notes                 String?
  enabled               Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  breaches              PwnBreach[]
  exposures             PwnExposure[]
  vulnerabilities       PwnVulnerability[]
  alerts                PwnAlert[]
  ingestionJobs         PwnIngestionJob[]
  forumSignals          PwnForumSignal[]
}

model PwnBreach {
  id                  String                @id @default(uuid())
  name                String
  description         String                @db.Text
  discoveredAt        DateTime?
  publishedAt         DateTime?
  firstSeenAt         DateTime?
  lastSeenAt          DateTime?
  sourceId            String?
  sourceUrl           String?
  verificationStatus  PwnVerificationStatus @default(UNVERIFIED)
  confidenceScore     Int                   @default(0)
  claimedRecordCount  Int?
  verifiedRecordCount Int?
  dataTypes           String[]
  severity            PwnSeverity           @default(MEDIUM)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  source              PwnSource?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  exposures           PwnExposure[]
  forumSignals        PwnForumSignal[]      @relation("ForumSignalBreach")

  @@unique([name, sourceId])
  @@index([sourceId])
  @@index([verificationStatus])
  @@index([severity])
}

model PwnExposure {
  id                 String                @id @default(uuid())
  kind               PwnExposureKind
  subjectHash        String
  subjectHint        String?
  breachId           String?
  sourceId           String?
  confidenceScore    Int                   @default(0)
  verificationStatus PwnVerificationStatus @default(UNVERIFIED)
  riskScore          Int?
  firstSeenAt        DateTime?
  lastSeenAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  breach             PwnBreach?            @relation(fields: [breachId], references: [id], onDelete: SetNull)
  source             PwnSource?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([subjectHash, breachId, sourceId])
  @@index([subjectHash])
  @@index([kind])
  @@index([sourceId])
  @@index([breachId])
}

model PwnVulnerability {
  id          String      @id @default(uuid())
  cveId       String      @unique
  description String      @db.Text
  cvssScore   Float?
  severity    PwnSeverity @default(MEDIUM)
  kev         Boolean     @default(false)
  sourceId    String?
  sourceUrl   String?
  publishedAt DateTime?
  references  Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  source      PwnSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([severity])
  @@index([kev])
}

model PwnOrganization {
  id          String                @id @default(uuid())
  name        String
  domain      String?
  ownerUserId String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  targets     PwnMonitoringTarget[]
  reports     PwnReport[]

  @@index([domain])
  @@index([ownerUserId])
}

model PwnMonitoringTarget {
  id                       String                      @id @default(uuid())
  userId                   String
  organizationId           String?
  targetType               PwnTargetType
  targetHash               String
  targetDisplay            String
  // Domain the owner monitors. Emails stay hash-only and this stays null.
  targetLookup             String?
  active                   Boolean                     @default(true)
  // Consultation stays pending until an administrator authorizes it.
  verificationStatus       PwnTargetVerificationStatus @default(PENDING)
  verificationTokenHash    String?
  authorizationRequestedAt DateTime?
  authorizationMessage     String?                     @db.VarChar(280)
  verifiedAt               DateTime?
  verifiedByUserId         String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization             PwnOrganization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  alerts                   PwnAlert[]

  @@unique([userId, targetType, targetHash])
  @@index([targetHash])
  @@index([organizationId])
  @@index([verificationStatus])
}

enum PwnTargetVerificationStatus {
  PENDING
  REQUESTED
  VERIFIED
  DENIED
}

model PwnAlert {
  id        String               @id @default(uuid())
  userId    String
  targetId  String?
  title     String
  body      String               @db.Text
  severity  PwnSeverity          @default(MEDIUM)
  status    String               @default("OPEN")
  sourceId  String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    PwnMonitoringTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  source    PwnSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([targetId])
  @@index([sourceId])
  @@index([createdAt])
}

model PwnReport {
  id              String           @id @default(uuid())
  userId          String
  organizationId  String?
  title           String
  summary         String           @db.Text
  createdByEngine Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    PwnOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
}

// actorId is intentionally not a foreign key so audit history survives user deletion.
model PwnAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model PwnIngestionJob {
  id         String     @id @default(uuid())
  sourceId   String?
  status     String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  error      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  source     PwnSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([status])
}

// Public thread titles and links from allowlisted forums — never post bodies, dumps or credentials.
model PwnForumSignal {
  id                 String                @id @default(uuid())
  sourceId           String?
  externalKey        String                @unique
  title              String
  link               String
  author             String?
  category           String?
  forum              String?
  signalKind         String                @default("OTHER")
  priorityRank       Int                   @default(0)
  titleKey           String?
  breachId           String?
  publishedAt        DateTime?
  verificationStatus PwnVerificationStatus @default(UNVERIFIED)
  lastSeenAt         DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  source             PwnSource?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  breach             PwnBreach?            @relation("ForumSignalBreach", fields: [breachId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([lastSeenAt])
  @@index([publishedAt])
  @@index([signalKind])
  @@index([priorityRank])
  @@index([titleKey])
  @@index([breachId])
}

// Shared rate-limit buckets so every app instance counts the same caller.
model PwnRateBucket {
  key       String   @id
  tokens    Float
  updatedAt DateTime @updatedAt
}

// Mercav Kosher (kosher.mercav.lat)

enum KosherPlaceType {
  restaurant
  bakery
  butcher
  grocery_branch
  judaica
  synagogue
  mikvah
  school
  hotel
  community
  museum
}

// De más a menos confianza. Los niveles nuevos (supervised … kosher_style) separan lo que antes caía en
// community_report o unknown: así cada persona filtra por su propio estándar.
enum KosherStatus {
  certified
  supervised
  self_declared
  some_products
  some_dishes
  community_report
  unknown
  kosher_style
  disputed
  closed
}

/// Desde qué nivel de kashrut quiere ver lugares de comida la persona.
enum KosherKashrutPreference {
  certified
  supervised
  all
}

enum KosherFood {
  meat
  dairy
  parve
}

enum KosherStockCategory {
  meat
  wine
  matzah
  cheese
  frozen
  bakery
}

enum KosherNusach {
  ashkenaz
  sefarad
  edot_hamizrach
  spanish_portuguese
  yemenite
  chabad
  other
}

enum KosherDenomination {
  orthodox
  conservative
  other
}

enum KosherStream {
  modern
  yeshivish
  chabad
  hasidic
  sephardi
  other
}

enum KosherRole {
  member
  local_moderator
  agency
}

enum KosherEditStatus {
  pending
  accepted
  rejected
}

model KosherProfile {
  id                String                   @id @default(uuid())
  userId            String                   @unique
  role              KosherRole               @default(member)
  denomination      KosherDenomination?
  orthodoxStream    KosherStream?
  city              String?
  countryCode       String?
  lat               Float?
  lng               Float?
  shabbatMode       Boolean                  @default(false)
  timezone          String?
  kashrutPreference KosherKashrutPreference?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KosherPlace {
  id             String                 @id @default(uuid())
  slug           String                 @unique
  name           String
  nameLocal      String?
  type           KosherPlaceType
  lat            Float
  lng            Float
  address        String
  city           String
  country        String
  countryCode    String                 @db.Char(2)
  chainId        String?
  chainName      String?
  status         KosherStatus           @default(community_report)
  agencyName     String?
  foodCategory   KosherFood?
  notes          String?                @db.Text
  source         String                 @default("community")
  confirmedAt    DateTime?
  phone          String?
  website        String?
  sourceUrl      String?
  verifiedAt     DateTime?
  certificateUrl String?
  certExpiresAt  DateTime?
  nusach         KosherNusach?
  denomination   KosherDenomination?
  orthodoxStream KosherStream?
  prayerTimes    Json?
  chalavIsrael   Boolean?
  patIsrael      Boolean?
  glatt          Boolean?
  beitYosef      Boolean?
  /// Horario semanal en hora local del lugar: { "0": [{ "open": "12:00", "close": "15:00" }], … }, 0 = domingo. Ver lib/kosher/hours.ts.
  hours          Json?
  /// Zona horaria IANA del lugar; si falta, la del país.
  timezone       String?
  /// 1 a 4 ($ a $$$$).
  priceLevel     Int?
  /// Claves de KOSHER_SERVICES (lib/kosher/labels.ts).
  services       String[]               @default([])
  /// Lugares importados de OpenStreetMap: "node/123", "way/456". Evita duplicarlos al reimportar.
  osmId          String?                @unique
  coverPhotoId   String?
  published      Boolean                @default(true)
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  createdBy      User?                  @relation("KosherPlaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  stock          KosherStockReport[]
  edits          KosherEditSuggestion[]
  reviews        KosherReview[]
  managers       KosherPlaceManager[]
  claims         KosherClaim[]
  events         KosherEvent[]
  minyanim       KosherMinyan[]
  photos         KosherPhoto[]
  favorites      KosherFavorite[]

  @@index([city, countryCode])
  @@index([type])
  @@index([status])
}

model KosherStockReport {
  id            String                    @id @default(uuid())
  placeId       String
  category      KosherStockCategory
  note          String                    @db.VarChar(300)
  authorId      String?
  authorName    String
  confirmations Int                       @default(0)
  reportedAt    DateTime                  @default(now())
  confirmedAt   DateTime                  @default(now())
  place         KosherPlace               @relation(fields: [placeId], references: [id], onDelete: Cascade)
  author        User?                     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  confirmedBy   KosherStockConfirmation[]

  @@index([placeId])
}

model KosherStockConfirmation {
  id        String            @id @default(uuid())
  reportId  String
  userId    String
  createdAt DateTime          @default(now())
  report    KosherStockReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
}

model KosherCommunity {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  city              String
  country           String
  countryCode       String   @db.Char(2)
  lat               Float
  lng               Float
  population        Int?
  populationYear    Int?
  populationSource  String?
  languages         String[]
  denominationNotes String?
  timezone          String   @default("UTC")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([city, countryCode])
}

model KosherEditSuggestion {
  id           String           @id @default(uuid())
  placeId      String
  authorId     String?
  authorName   String
  field        String
  oldValue     String?          @db.Text
  newValue     String           @db.Text
  note         String?          @db.VarChar(500)
  status       KosherEditStatus @default(pending)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  place        KosherPlace      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  author       User?            @relation("KosherEditAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([placeId])
}

model KosherReview {
  id        String      @id @default(uuid())
  placeId   String
  userId    String
  rating    Int
  body      String?     @db.VarChar(600)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  place     KosherPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([placeId])
}

// threadKey is "city:<slug>" or "place:<slug>"; conversations never span the whole platform.
model KosherMessage {
  id        String              @id @default(uuid())
  threadKey String
  userId    String
  body      String              @db.VarChar(500)
  hidden    Boolean             @default(false)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  flags     KosherMessageFlag[]

  @@index([threadKey, createdAt])
}

model KosherMessageFlag {
  id        String        @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime      @default(now())
  message   KosherMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

enum KosherReviewState {
  pending
  approved
  rejected
}

enum KosherEventKind {
  shiur
  tefila
  jag
  comunidad
  juventud
  otro
}

enum KosherPrayer {
  shacharit
  mincha
  maariv
}

enum KosherChesedKind {
  volunteer
  bikur_cholim
  donation
  need
}

enum KosherHostRequestStatus {
  pending
  accepted
  declined
}

enum KosherClaimKind {
  ownership
  certificate
}

model KosherEvent {
  id          String            @id @default(uuid())
  kind        KosherEventKind
  title       String
  body        String?           @db.Text
  city        String
  countryCode String            @db.Char(2)
  placeId     String?
  startsAt    DateTime
  endsAt      DateTime?
  official    Boolean           @default(false)
  state       KosherReviewState @default(pending)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  place       KosherPlace?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([city, countryCode, startsAt])
  @@index([state])
}

model KosherMinyan {
  id           String             @id @default(uuid())
  prayer       KosherPrayer
  startsAt     DateTime
  city         String
  countryCode  String             @db.Char(2)
  placeId      String?
  locationNote String?
  note         String?
  createdById  String
  createdAt    DateTime           @default(now())
  place        KosherPlace?       @relation(fields: [placeId], references: [id], onDelete: SetNull)
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  rsvps        KosherMinyanRsvp[]

  @@index([city, countryCode, startsAt])
}

model KosherMinyanRsvp {
  minyanId  String
  userId    String
  createdAt DateTime     @default(now())
  minyan    KosherMinyan @relation(fields: [minyanId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([minyanId, userId])
}

model KosherHost {
  id          String              @id @default(uuid())
  userId      String              @unique
  city        String
  countryCode String              @db.Char(2)
  capacity    Int
  meals       String[]
  kashrut     String
  about       String              @db.Text
  state       KosherReviewState   @default(pending)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests    KosherHostRequest[]

  @@index([city, countryCode, state])
}

model KosherHostRequest {
  id        String                  @id @default(uuid())
  hostId    String
  guestId   String
  date      DateTime
  guests    Int
  message   String                  @db.Text
  status    KosherHostRequestStatus @default(pending)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  host      KosherHost              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  guest     User                    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([hostId, guestId, date])
}

model KosherChesed {
  id          String            @id @default(uuid())
  kind        KosherChesedKind
  title       String
  body        String            @db.Text
  city        String
  countryCode String            @db.Char(2)
  contact     String?
  state       KosherReviewState @default(pending)
  closed      Boolean           @default(false)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([city, countryCode, state])
}

model KosherAlert {
  id          String   @id @default(uuid())
  userId      String
  city        String
  countryCode String   @db.Char(2)
  topics      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, city, countryCode])
  @@index([city, countryCode])
}

model KosherPlaceManager {
  placeId   String
  userId    String
  createdAt DateTime    @default(now())
  place     KosherPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([placeId, userId])
}

model KosherClaim {
  id             String            @id @default(uuid())
  kind           KosherClaimKind
  placeId        String
  userId         String
  contactName    String
  contactRole    String
  contactPhone   String?
  evidence       String            @db.Text
  agencyName     String?
  certificateUrl String?
  certExpiresAt  DateTime?
  state          KosherReviewState @default(pending)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  place          KosherPlace       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
}

/// Fotos de un lugar. Se guardan en la base (ya achicadas en el navegador) y se sirven desde /api/kosher/photos/[id].
model KosherPhoto {
  id           String      @id @default(uuid())
  placeId      String
  data         Bytes
  mime         String      @db.VarChar(40)
  width        Int
  height       Int
  bytes        Int
  caption      String?     @db.VarChar(140)
  position     Int         @default(0)
  uploadedById String?
  createdAt    DateTime    @default(now())
  place        KosherPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  uploadedBy   User?       @relation("KosherPhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([placeId, position])
}

/// Lugares guardados por una persona (Guardar en la ficha).
model KosherFavorite {
  userId    String
  placeId   String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     KosherPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@index([placeId])
}

model KosherInvite {
  id          String    @id @default(uuid())
  token       String    @unique
  placeId     String
  createdById String
  note        String?
  expiresAt   DateTime
  usedById    String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([placeId])
}

model UnusualTrafficEvent {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  reason      String
  ip          String
  userAgent   String?  @db.VarChar(512)
  fingerprint String?  @db.VarChar(160)
  path        String?  @db.VarChar(300)
  userId      String?
  userEmail   String?  @db.VarChar(190)
  userName    String?  @db.VarChar(120)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([ip])
  @@index([userId])
}

// ─── Calendario de feriados (app.mercav.lat/calendario) ───────────────────────

/// Qué feriados y fechas festivas quiere ver cada persona. Sin fila = valores por defecto.
model CalendarPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Fuentes activas, por ejemplo FERIADOS_NACIONALES, FERIADOS_REGIONALES, JUDIO_FIESTAS, JUDIO_AYUNOS.
  sources   String[] @default([])
  /// País de los feriados (ISO 3166-1 alfa-2: BO, AR, MX…).
  country   String?
  /// Región del país para los feriados regionales (departamento, provincia o estado).
  region    String?
  /// Calendario judío según Israel (true) o la diáspora (false).
  israel    Boolean  @default(false)
  /// Claves de fechas puntuales que la persona ocultó.
  hidden    String[] @default([])
  /// Token del link secreto para suscribirse desde Google Calendar, Apple o Outlook (webcal). Se puede regenerar.
  feedToken String?  @unique
  updatedAt DateTime @updatedAt
}

// ─── Mercav Business (app.mercav.lat/business) ────────────────────────────────

enum BusinessRole {
  OWNER
  HR_ADMIN
  MANAGER
  EMPLOYEE
  ACCOUNTANT
}

enum BusinessEmployeeStatus {
  ACTIVE
  INACTIVE
}

enum BusinessContractType {
  INDEFINIDO
  PLAZO_FIJO
  EVENTUAL
  PASANTIA
  CONSULTORIA
}

enum BusinessPayrollStatus {
  DRAFT
  CLOSED
}

/// Empresa (tenant privado de RR.HH.). Toda consulta de Business se filtra por workspaceId.
model BusinessWorkspace {
  id              String               @id @default(cuid())
  slug            String               @unique
  name            String
  legalName       String?
  nit             String?
  /// País de la empresa (ISO 3166-1 alfa-2). Define feriados, moneda y motor de planillas.
  country         String               @default("BO")
  /// Moneda de los sueldos (ISO 4217).
  currency        String               @default("BOB")
  /// Departamento, provincia o estado.
  region          String?
  city            String?
  logoUrl         String?
  brandColor      String?
  /// Empresa productiva: el bono de antigüedad se calcula sobre 3 salarios mínimos.
  productive      Boolean              @default(false)
  ownerId         String
  owner           User                 @relation("BusinessOwner", fields: [ownerId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  members         BusinessMember[]
  employees       BusinessEmployee[]
  invites         BusinessInvite[]
  payrollRuns     BusinessPayrollRun[]
  auditLogs       BusinessAuditLog[]
  loyaltyPrograms LoyaltyProgram[]
  posConfig       POSConfig?
  publicPage      BusinessPublicPage?
  guideProgress   BusinessGuideProgress[]

  @@index([ownerId])
}

/// Estado reanudable de la ayuda contextual. Los hitos operativos siempre se recalculan desde el servidor.
model BusinessGuideProgress {
  id          String            @id @default(cuid())
  userId      String
  workspaceId String
  dismissedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

/// Acceso de un usuario Mercav a una empresa.
model BusinessMember {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        BusinessRole      @default(EMPLOYEE)
  createdAt   DateTime          @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Legajo del trabajador. userId es opcional: no todos tienen cuenta Mercav.
model BusinessEmployee {
  id             String                 @id @default(cuid())
  workspaceId    String
  workspace      BusinessWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  /// Carnet de identidad, cifrado (AES-256-GCM).
  ciEnc          String?
  ciExt          String?
  birthDate      DateTime?
  sex            String?
  nationality    String?
  email          String?
  phone          String?
  position       String?
  hireDate       DateTime
  endDate        DateTime?
  contractType   BusinessContractType   @default(INDEFINIDO)
  baseSalary     Decimal                @db.Decimal(12, 2)
  bankName       String?
  /// Cuenta bancaria, cifrada (AES-256-GCM).
  bankAccountEnc String?
  /// NUA/CUA de la Gestora.
  nua            String?
  cnsNumber      String?
  status         BusinessEmployeeStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  payrollLines   BusinessPayrollLine[]
  invites        BusinessInvite[]

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
}

/// Invitación de un solo uso para unirse a una empresa. Solo se guarda el hash del token.
model BusinessInvite {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    BusinessEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  email       String?
  role        BusinessRole      @default(EMPLOYEE)
  tokenHash   String            @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime          @default(now())

  @@index([workspaceId])
}

/// Planilla mensual. params guarda los parámetros laborales usados (SMN, porcentajes) para auditar.
model BusinessPayrollRun {
  id          String                @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  status      BusinessPayrollStatus @default(DRAFT)
  params      Json
  createdById String
  closedAt    DateTime?
  closedById  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  lines       BusinessPayrollLine[]

  @@unique([workspaceId, year, month])
}

/// Una fila de la planilla: las entradas editables y el resultado calculado.
model BusinessPayrollLine {
  id                String             @id @default(cuid())
  runId             String
  run               BusinessPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          BusinessEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  daysWorked        Int                @default(30)
  overtimeHours     Decimal            @default(0) @db.Decimal(8, 2)
  sundayHolidayDays Decimal            @default(0) @db.Decimal(6, 2)
  otherBonuses      Decimal            @default(0) @db.Decimal(12, 2)
  advances          Decimal            @default(0) @db.Decimal(12, 2)
  otherDeductions   Decimal            @default(0) @db.Decimal(12, 2)
  /// Crédito fiscal por facturas presentadas (Formulario 110), en Bs.
  rcivaCredit       Decimal            @default(0) @db.Decimal(12, 2)
  /// Desglose completo calculado por lib/business/bolivia/payroll.
  result            Json
  totalEarned       Decimal            @db.Decimal(12, 2)
  totalDeductions   Decimal            @db.Decimal(12, 2)
  netPay            Decimal            @db.Decimal(12, 2)
  employerCost      Decimal            @db.Decimal(12, 2)
  updatedAt         DateTime           @updatedAt

  @@unique([runId, employeeId])
  @@index([employeeId])
}

/// Registro de cambios sensibles (salarios, legajos, planillas). actorId sin FK a propósito.
model BusinessAuditLog {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([workspaceId, createdAt])
}

// ─── Mercav Business · Fidelización (tarjetas de cliente frecuente) ───────────

enum LoyaltyProgramType {
  STAMPS
  POINTS
}

enum LoyaltyProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LoyaltyCardStatus {
  ACTIVE
  BLOCKED
}

enum LoyaltyHolderStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum LoyaltyEventType {
  JOIN
  WELCOME
  STAMP
  POINTS
  REDEEM
  ADJUST
  EXPIRE
  BIRTHDAY
  REFERRAL
}

enum LoyaltyEventSource {
  STAFF
  SELF_SERVICE
  SYSTEM
}

/// Programa de fidelización de una empresa. El slug es la URL pública para sumarse (/c/<slug>).
model LoyaltyProgram {
  id             String               @id @default(cuid())
  workspaceId    String
  workspace      BusinessWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug           String               @unique
  name           String
  type           LoyaltyProgramType   @default(STAMPS)
  /// Rubro (CAFE, PELUQUERIA, GIMNASIO…): define ícono, textos y diseño sugerido.
  businessType   String
  /// Reglas del motor (meta de sellos, puntos por monto, topes, vencimiento, bonos, niveles).
  rules          Json
  /// Diseño de la tarjeta (paleta, logo, beneficios, textos).
  design         Json
  status         LoyaltyProgramStatus @default(DRAFT)
  /// Secreto del QR rotativo del mostrador (autoservicio), cifrado.
  kioskSecretEnc String?
  /// Próximo número de cliente de este programa (se reserva dentro de la transacción del alta).
  nextCustomerNo Int                  @default(1)
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  rewards        LoyaltyReward[]
  cards          LoyaltyCard[]
  events         LoyaltyEvent[]
  campaigns      LoyaltyCampaign[]

  @@index([workspaceId])
}

/// Premio canjeable: cuesta `cost` sellos o puntos.
model LoyaltyReward {
  id          String         @id @default(cuid())
  programId   String
  program     LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name        String
  description String?
  cost        Int
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  events      LoyaltyEvent[]

  @@index([programId])
}

/// Tarjeta de un cliente en un programa. El serial va en el QR y en el link de la tarjeta web.
model LoyaltyCard {
  id                 String              @id @default(cuid())
  programId          String
  program            LoyaltyProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  serial             String              @unique
  referralCode       String              @unique
  /// Número de cliente dentro del programa (#1, #2…). Lo ve solo el personal de ese negocio.
  customerNo         Int
  customerName       String
  phone              String?
  email              String?
  /// Cumpleaños sin año, MM-DD.
  birthday           String?
  marketingConsent   Boolean             @default(false)
  balance            Int                 @default(0)
  lifetime           Int                 @default(0)
  visits             Int                 @default(0)
  lastVisitAt        DateTime?
  lastBirthdayYear   Int?
  referredById       String?
  referredBy         LoyaltyCard?        @relation("LoyaltyReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          LoyaltyCard[]       @relation("LoyaltyReferrals")
  referralRewarded   Boolean             @default(false)
  /// Cuenta Mercav del cliente: la vincula el cliente desde su tarjeta o el negocio con su código MercavClub.
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkedAt           DateTime?
  /// Titular: PENDING al vincular; VERIFIED cuando el negocio revisó su documento en persona.
  holderStatus       LoyaltyHolderStatus @default(UNVERIFIED)
  holderVerifiedAt   DateTime?
  holderVerifiedById String?
  /// Tipo y últimos 4 dígitos del documento revisado (nunca el número completo).
  holderDocType      String?
  holderDocLast4     String?
  /// Quién dio de alta la tarjeta desde el negocio (null: el cliente solo, con el QR).
  createdById        String?
  /// Cuándo se aceptó el aviso de datos reales (alta o vinculación).
  realDataAckAt      DateTime?
  status             LoyaltyCardStatus   @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  events             LoyaltyEvent[]

  @@unique([programId, customerNo])
  @@unique([programId, userId])
  @@unique([programId, phone])
  @@index([userId])
  @@index([programId, status])
  @@index([programId, lastVisitAt])
}

/// Cada movimiento de una tarjeta. clientRef evita sellar dos veces si se corta la red.
model LoyaltyEvent {
  id             String             @id @default(cuid())
  cardId         String
  card           LoyaltyCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  programId      String
  program        LoyaltyProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  type           LoyaltyEventType
  amount         Int
  balanceAfter   Int
  rewardId       String?
  reward         LoyaltyReward?     @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  /// Monto de la compra (programas por puntos), para estadísticas.
  purchaseAmount Decimal?           @db.Decimal(12, 2)
  source         LoyaltyEventSource @default(STAFF)
  actorUserId    String?
  note           String?
  clientRef      String?            @unique
  createdAt      DateTime           @default(now())

  @@index([programId, createdAt])
  @@index([cardId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Mensaje del negocio a sus clientes (se muestra en la tarjeta; con Wallet, también como aviso).
model LoyaltyCampaign {
  id          String         @id @default(cuid())
  programId   String
  program     LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  title       String
  body        String
  audience    Json
  recipients  Int            @default(0)
  createdById String
  createdAt   DateTime       @default(now())
  expiresAt   DateTime?

  @@index([programId, createdAt])
}


/// Presentación comercial explícita. El catálogo operativo se consulta por tenant, nunca se duplica.
model BusinessPublicPage {
  id          String            @id @default(cuid())
  workspaceId String            @unique
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publicSlug  String?           @unique
  status      BusinessPublicPageStatus @default(DRAFT)
  draft       Json
  published   Json?
  version     Int               @default(1)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  aliases     BusinessPublicPageAlias[]

  @@index([status])
}

enum BusinessPublicPageStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

/// Un enlace reservado nunca puede ser reclamado por otro negocio, incluso después de pausarlo.
model BusinessPublicPageAlias {
  slug      String             @id
  pageId    String
  page      BusinessPublicPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  activated Boolean            @default(false)
  createdAt DateTime           @default(now())

  @@index([pageId])
}
